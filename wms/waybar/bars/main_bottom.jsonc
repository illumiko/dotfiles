{
  // "height": 10,
  "name": "bot",
  "layer": "top",
  "reload_style_on_change": true,
  "mod": "dock",
  "exclusive": true,
  "spacing": 0,
  "passthrough": false,
  "gtk-layer-shell": true,
  // "width": 30,
  "margin-bottom": 0,
  "margin-right": 0,
  "margin-left": 0,
  "margin-top": 0,
  // "margin-right":15,
  // "margin-left": 15,
  "fixed-center": true,
  // "width":0,
  "modules-center":["hyprland/window"],
    "hyprland/window": {
        "format": "{}",
    },
  "modules-left":["battery"],
  "battery":{
    "format": "{time} | {capacity} % ",
  },
  "modules-right":["custom/sleep"],
  "custom/sleep": {
    "format": "  󰤄   ",
    "on-click": "systemctl sleep && hyprlock",
  },
}
